# =============================================================
# Fichier EXEMPLE de configuration — À copier en ".env"
# =============================================================

# Clé secrète Django (générer une nouvelle en production)
SECRET_KEY=CHANGE_ME_IN_PRODUCTION

# Mode debug (mettre à False en production)
DEBUG=True

# Hôtes autorisés (séparés par des virgules)
ALLOWED_HOSTS=127.0.0.1,localhost

# Base de données
DB_ENGINE=django.db.backends.mysql
DB_NAME=pneumonie_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
